# ==============================================================================
# Admin Dashboard - Environment Variables Template
# Copy this file to `.env.local` (for local dev) or `.env` / `.env.admin` (for production VPS).
# ==============================================================================

# ─── 1. Supabase Configuration ────────────────────────────────────────────────
# Hostname của Supabase project (cần thiết cho Next/Image remotePatterns)
NEXT_PUBLIC_SUPABASE_HOSTNAME=your-project.supabase.co
# URL đầy đủ tới Supabase Project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon Key (Public Key) dùng cho client components
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service Role Key (Secret Key) đặc quyền cao nhất, chỉ dùng trên Server Route Handlers
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── 2. Service & Application URLs ───────────────────────────────────────────
# Địa chỉ trang web User (Dùng để chuyển hướng đăng nhập và đăng xuất chung)
# - Local dev: http://localhost:3000
# - Production VPS: https://yourdomain.com
NEXT_PUBLIC_USER_URL=http://localhost:3000

# Cổng chạy ứng dụng (Mặc định: 3001)
PORT=3001

# ─── 3. JWT Authentication & Single Sign-On (SSO) ─────────────────────────────
# Secret key dùng để ký và giải mã JWT token (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=your-jwt-secret-at-least-32-chars
ADMIN_JWT_SECRET=your-admin-jwt-secret-at-least-32-chars

# Chia sẻ Cookie giữa domain User (yourdomain.com) và Admin (admin.yourdomain.com):
# - Local dev: Để trống hoặc comment lại (mặc định host-only localhost)
# - Production VPS: Bỏ comment và điền domain có dấu chấm ở đầu: .yourdomain.com
# COOKIE_DOMAIN=.yourdomain.com

# ─── 4. Cloudflare R2 / Object Storage (Media Uploads) ────────────────────────
# Account ID của Cloudflare (tìm trong Cloudflare Dashboard -> R2 Overview)
R2_ACCOUNT_ID=your-cloudflare-account-id
# Access Key ID và Secret Access Key từ R2 API Tokens (quyền Object Read & Write)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Tên Bucket R2
R2_BUCKET_NAME=your-bucket-name
# Public URL của Bucket (dùng hiển thị ảnh / media trên giao diện và backend)
R2_PUBLIC_URL=https://pub-your-bucket.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-bucket.r2.dev

# ─── 5. Feature Flags (Chế độ Under Construction) ─────────────────────────────
# Điều khiển bật/tắt các module đang phát triển trong Admin.
# Hỗ trợ: true/false. Mặc định: false (hiển thị trang Đang phát triển).
NEXT_PUBLIC_ENABLE_ADVANCED_ANALYTICS=false
NEXT_PUBLIC_ENABLE_BULK_EXPORT=false
